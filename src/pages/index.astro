---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header title={SITE_TITLE} />

    <div class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="hero-kicker">Notion &middot; Astro &middot; MDX</p>
        <h1 class="hero-title">Content, without the complexity.</h1>
        <p class="hero-sub">Write in Notion &mdash; publish with Astro.</p>
      </div>
    </div>

    <main>
      <section class="intro">
        <p>
          This template shows how <a href="https://astro.build/">Astro</a> and
          <a href="https://www.notion.so/">Notion</a> can serve as a lightweight CMS. Posts are pulled from a Notion database
          via the official
          <a href="https://www.npmjs.com/package/@notionhq/client">Notion SDK</a>, converted to Markdown, and dropped
          into <code>src/content/blog</code>. A <a href="https://github.com/features/actions">GitHub Actions</a> workflow
          can run <code>pnpm sync</code> on a schedule to keep things fresh automatically.
        </p>
      </section>

      <section class="links-section">
        <h2 class="links-heading">Quick links</h2>
        <div class="link-grid">
          <a
            class="link-card"
            href="https://github.com/ndamulelonemakh/notion-cms-astro-blog"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="link-card-title">GitHub Repo</span>
            <span class="link-card-desc">Source code, issues &amp; contributions</span>
          </a>
          <a
            class="link-card"
            href="https://developers.notion.com/reference/intro"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="link-card-title">Notion API Docs</span>
            <span class="link-card-desc">Official REST API reference</span>
          </a>
          <a
            class="link-card"
            href="https://docs.astro.build/en/guides/content-collections/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="link-card-title">Content Collections</span>
            <span class="link-card-desc">Astro's typed content layer</span>
          </a>
        </div>
      </section>

      <Footer />

      <style>
        /* ── Hero ───────────────────────────────────────────────── */
        .hero {
          position: relative;
          height: 40vh;
          min-height: 280px;
          background-image: url("/smiley-robot-header-01.png");
          background-size: cover;
          background-position: center top;
          overflow: hidden;
        }
        .hero-overlay {
          position: absolute;
          inset: 0;
          background: linear-gradient(
            150deg,
            rgba(8, 8, 28, 0.78) 0%,
            rgba(22, 12, 68, 0.62) 55%,
            rgba(0, 0, 0, 0.3) 100%
          );
        }
        .hero-content {
          position: relative;
          z-index: 1;
          height: 100%;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          padding: 0 1.5rem;
          gap: 0.55rem;
        }
        .hero-kicker {
          margin: 0;
          font-size: 0.72rem;
          letter-spacing: 0.2em;
          text-transform: uppercase;
          color: rgba(255, 255, 255, 0.55);
        }
        .hero-title {
          margin: 0;
          font-size: clamp(1.5rem, 4vw, 2.5rem);
          font-weight: 700;
          color: #fff;
          line-height: 1.15;
          letter-spacing: -0.025em;
        }
        .hero-sub {
          margin: 0;
          font-size: 0.95rem;
          color: rgba(255, 255, 255, 0.65);
        }

        /* ── Intro ──────────────────────────────────────────────── */
        .intro {
          border-left: 3px solid var(--accent);
          padding: 0.25rem 0 0.25rem 1.4rem;
          margin-bottom: 3rem;
        }
        .intro p {
          margin: 0;
          font-size: 0.95rem;
          line-height: 1.8;
          color: rgb(var(--gray-dark));
        }
        .intro a {
          color: var(--accent);
          text-decoration: none;
          border-bottom: 1px solid transparent;
          transition: border-color 0.15s ease;
        }
        .intro a:hover {
          border-bottom-color: var(--accent);
        }
        .intro code {
          background: rgb(var(--gray-light));
          padding: 0.1em 0.4em;
          border-radius: 4px;
          font-size: 0.86em;
        }

        /* ── Link grid ──────────────────────────────────────────── */
        .links-heading {
          font-size: 0.68rem;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          color: rgb(var(--gray));
          font-weight: 600;
          margin-bottom: 1rem;
        }
        .link-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
          gap: 0.9rem;
          margin-bottom: 4rem;
        }
        .link-card {
          display: flex;
          flex-direction: column;
          gap: 0.3rem;
          padding: 1.1rem 1.25rem;
          border: 1px solid rgb(var(--gray-light));
          border-radius: 10px;
          background: #fff;
          text-decoration: none;
          transition:
            box-shadow 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
        }
        .link-card:hover {
          box-shadow: var(--box-shadow);
          border-color: var(--accent);
          transform: translateY(-3px);
        }
        .link-card-title {
          font-size: 0.92rem;
          font-weight: 700;
          color: rgb(var(--black));
        }
        .link-card-desc {
          font-size: 0.78rem;
          color: rgb(var(--gray));
          line-height: 1.45;
        }
      </style>
    </main>
  </body>
</html>
