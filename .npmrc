# Enforce the node engine constraint declared in package.json
engine-strict=true

# Use strict dep resolution — fail on peer dep conflicts rather than silently ignoring them
strict-peer-dependencies=false

# Automatically install missing peer dependencies
auto-install-peers=true

# Keep node_modules non-flat (default in pnpm) — prevents phantom dependency access
# This is pnpm's default but made explicit for auditability
node-linker=isolated

# Prevent arbitrary lifecycle scripts from running during install.
# Only packages listed in pnpm.onlyBuiltDependencies (package.json) may run them.
ignore-scripts=false
